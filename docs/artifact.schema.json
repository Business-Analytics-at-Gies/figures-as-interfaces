{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FigureFlow artifact v1",
  "type": "object",
  "required": [
    "format_version",
    "artifact_id",
    "dataset",
    "dataset_hash",
    "source",
    "figures",
    "versions",
    "head"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string"
    },
    "dataset": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dataset_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object"
    },
    "figures": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/figure"
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/version"
      }
    },
    "head": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "figure": {
      "type": "object",
      "required": [
        "V",
        "C",
        "D",
        "M",
        "R"
      ],
      "properties": {
        "V": {
          "type": "object",
          "required": [
            "spec",
            "png",
            "summary"
          ],
          "properties": {
            "spec": {
              "type": "object",
              "required": [
                "data",
                "encoding",
                "mark"
              ],
              "properties": {
                "data": {
                  "type": "object",
                  "required": [
                    "values"
                  ],
                  "properties": {
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "mark_id"
                        ],
                        "properties": {
                          "mark_id": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "png": {
              "type": "string",
              "contentEncoding": "base64",
              "contentMediaType": "image/png"
            },
            "summary": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "C": {
          "type": "object",
          "required": [
            "actions",
            "sql",
            "visualization_python",
            "environment"
          ],
          "properties": {
            "actions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "op"
                ],
                "properties": {
                  "op": {
                    "type": "string"
                  }
                }
              }
            },
            "sql": {
              "type": "string"
            },
            "visualization_python": {
              "type": "string"
            },
            "environment": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "D": {
          "type": "object",
          "required": [
            "rows",
            "schema",
            "results",
            "result_schema"
          ],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "result_schema": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "M": {
          "type": "object",
          "required": [
            "figure_id",
            "version_id",
            "timestamp",
            "operation",
            "instruction",
            "artifact_id",
            "artifact_version"
          ],
          "properties": {
            "figure_id": {
              "type": "string"
            },
            "version_id": {
              "type": "string"
            },
            "timestamp": {
              "type": "string"
            },
            "operation": {
              "type": "string"
            },
            "instruction": {
              "type": "string"
            },
            "artifact_id": {
              "type": "string"
            },
            "artifact_version": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "R": {
          "type": "object",
          "required": [
            "mark_to_rows"
          ],
          "properties": {
            "mark_to_rows": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "required": [
        "parents",
        "figures",
        "links",
        "input",
        "timestamp"
      ],
      "properties": {
        "parents": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 1
        },
        "figures": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "input": {
          "type": "object"
        },
        "timestamp": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": [
        "source",
        "target",
        "dimensions",
        "action_template"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "dimensions": {
          "const": [
            "pickup_hour",
            "pickup_borough"
          ]
        },
        "action_template": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
